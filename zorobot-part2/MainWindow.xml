<Window x:Class="ZoroCyberSecurityBot.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2000/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2000/xaml"
        Title="Zoro: Slice Through Cyber Threats" Height="650" Width="750"
        Background="#121212" WindowStartupLocation="CenterScreen">
	<Grid Margin="15">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<Border Grid.Row="0" Background="#1E1E1E" CornerRadius="5" Padding="10" Margin="0,0,0,10" BorderBrush="#00FFCC" BorderThickness="1">
			<StackPanel HorizontalAlignment="Center">
				<TextBlock FontFamily="Consolas" FontSize="10" Foreground="#00FFCC" HorizontalAlignment="Center" TextAlignment="Center">
					███████╗ ██████╗ ██████╗  ██████╗
					╚══███╔╝██╔═══██╗██╔══██╗██╔═══██╗
					███╔╝ ██║   ██║██████╔╝██║   ██║
					███╔╝  ██║   ██║██╔══██╗██║   ██║
					███████╗╚██████╔╝██║  ██║╚██████╔╝
					╚══════╝ ╚═════╝ ╚═╝  ╚═╝ ╚═════╝
				</TextBlock>
				<TextBlock Text="&gt;&gt; Zoro: Slice Through Cyber Threats &lt;&lt;" Foreground="#FFCC00" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" Margin="0,5,0,0"/>
			</StackPanel>
		</Border>

		<Border x:Name="SetupPanel" Grid.Row="1" Background="#1E1E1E" CornerRadius="5" Padding="10" Margin="0,0,0,10">
			<StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
				<TextBlock Text="[?] State your name, user: " Foreground="#FFFFFF" VerticalAlignment="Center" FontSize="13"/>
				<TextBox x:Name="TxtNameInput" Width="150" Margin="10,0" Background="#2D2D2D" Foreground="#FFFFFF" BorderBrush="#00FFCC" Padding="3" VerticalAlignment="Center" KeyDown="TxtNameInput_KeyDown"/>
				<Button x:Name="BtnStart" Content="Initialize Zoro" Background="#00FFCC" Foreground="#121212" FontWeight="Bold" Padding="10,4" Click="BtnStart_Click" Cursor="Hand"/>
			</StackPanel>
		</Border>

		<Grid Grid.Row="2" Margin="0,0,0,10">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*"/>
				<ColumnDefinition Width="220"/>
			</Grid.ColumnDefinitions>

			<Border Grid.Column="0" Background="#1E1E1E" CornerRadius="5" Padding="10" Margin="0,0,10,0">
				<ScrollViewer x:Name="ChatScroll" VerticalScrollBarVisibility="Auto">
					<TextBlock x:Name="TxtChatLog" TextWrapping="Wrap" FontFamily="Consolas" FontSize="13" Foreground="#FFFFFF"/>
				</ScrollViewer>
			</Border>

			<StackPanel Grid.Column="1">
				<Border Background="#1E1E1E" CornerRadius="5" Padding="10" Margin="0,0,0,10" BorderBrush="#333333" BorderThickness="1">
					<StackPanel>
						<TextBlock Text="🧠 ZORO'S MEMORY" Foreground="#FFCC00" FontWeight="Bold" Margin="0,0,0,5"/>
						<Separator Background="#333333" Margin="0,0,0,5"/>
						<TextBlock x:Name="TxtMemoryName" Text="User: Not Set" Foreground="#A0A0A0" Margin="0,2"/>
						<TextBlock x:Name="TxtMemoryTopic" Text="Interest: None" Foreground="#A0A0A0" Margin="0,2"/>
					</StackPanel>
				</Border>

				<Border Background="#1E1E1E" CornerRadius="5" Padding="10" BorderBrush="#333333" BorderThickness="1">
					<StackPanel>
						<TextBlock Text="📊 SENTIMENT ANALYSIS" Foreground="#FFCC00" FontWeight="Bold" Margin="0,0,0,5"/>
						<Separator Background="#333333" Margin="0,0,0,5"/>
						<TextBlock x:Name="TxtCurrentSentiment" Text="Current Mood: Neutral" Foreground="#00FFCC" FontWeight="SemiBold"/>
					</StackPanel>
				</Border>
			</StackPanel>
		</Grid>

		<Grid Grid.Row="3" x:Name="ChatInputPanel" Visibility="Collapsed">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*"/>
				<ColumnDefinition Width="80"/>
			</Grid.ColumnDefinitions>
			<TextBox x:Name="TxtUserInput" Grid.Column="0" Background="#1E1E1E" Foreground="#FFFFFF" BorderBrush="#00FFCC" CaretBrush="#FFFFFF" Padding="8" FontSize="13" KeyDown="TxtUserInput_KeyDown"/>
			<Button x:Name="BtnSend" Grid.Column="1" Content="Strike" Background="#00FFCC" Foreground="#121212" FontWeight="Bold" Margin="5,0,0,0" Click="BtnSend_Click" Cursor="Hand"/>
		</Grid>
	</Grid>
</Window>